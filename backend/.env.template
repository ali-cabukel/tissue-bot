# Copy to .env in this directory (never commit .env)
#
#   cp .env.template .env

# GitHub personal access token (repo scope minimum)
# Fallback: `gh auth login` token via `gh auth token`
GITHUB_TOKEN=

# SQLite database path (default: backend/data/tissue-bot.db)
DB_PATH=

# GitHub REST API base URL (default: https://api.github.com)
GITHUB_API_BASE_URL=

# Path to tracked repos list (default: scripts/config/scientific-repos.txt)
TRACKED_REPOS_FILE=

# Auth / API (required for tissue-api)
SECRET_KEY=
JWT_LIFETIME_SECONDS=3600
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=false
