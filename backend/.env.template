# Copy to .env in this directory (never commit .env)
#
#   cp .env.template .env

# GitHub personal access token (repo scope minimum)
# Fallback: `gh auth login` token via `gh auth token`
GITHUB_TOKEN=

# SQLite database path (default: backend/data/tissue-bot.db). Ignored when DATABASE_URL is set.
DB_PATH=

# Postgres / Supabase (production). Use schema isolation on a shared Supabase instance.
# DATABASE_URL=postgresql://postgres:password@db.project.supabase.co:5432/postgres
# DATABASE_SCHEMA=tissue-bot

# GitHub REST API base URL (default: https://api.github.com)
GITHUB_API_BASE_URL=

# Path to tracked repos list (default: scripts/config/scientific-repos.txt)
TRACKED_REPOS_FILE=

# Auth / API (required for tissue-api)
SECRET_KEY=
JWT_LIFETIME_SECONDS=3600
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=false
# Bundled Docker / Cloud Run only (FastAPI serves Next static export)
# STATIC_DIR=/app/static

# LLM for issue-resolution agent — auto prefers Anthropic when ANTHROPIC_API_KEY is set, else Ollama
# LLM_PROVIDER=auto | anthropic | ollama

# Anthropic (production / Cloud Run — https://console.anthropic.com/)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Ollama (local — used when LLM_PROVIDER=ollama or auto without Anthropic key)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# LangGraph checkpoints (SQLite file locally; Postgres when DATABASE_URL is set)
CHECKPOINT_DB_PATH=
